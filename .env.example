# Copy to .env at repository root. Development only; never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/colearnia?replicaSet=rs0&directConnection=true
# Initial development budgets, not measured capacity guarantees.
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=15000
# Shared single-process User/Workspace coordination; initial budgets, tune after measurement.
COORDINATOR_MAX_PENDING_PER_KEY=64
COORDINATOR_MAX_OPERATIONS=1024
COORDINATOR_WAIT_TIMEOUT_MS=5000
# Enable auth with a generated secret (openssl rand -hex 32) and a matching APP_ORIGIN.
SESSION_SECRET=
# Only enable when the server is reachable exclusively through one trusted proxy.
AUTH_TRUST_PROXY=false
AUTH_TTL_SECONDS=604800
MEDIA_ENABLED=false
MEDIA_LISTEN_IP=127.0.0.1
MEDIA_ANNOUNCED_ADDRESS=127.0.0.1
MEDIA_PORT=40000
TURN_URLS=turn:localhost:3478
TURN_SECRET=replace-with-a-random-turn-secret
FILE_ROOT=./storage/files
TEMP_ROOT=./storage/frames
# Browser uses Vite proxy; no private credentials belong in VITE_* variables.
VITE_API_BASE_URL=/api/v1
