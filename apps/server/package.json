{
  "name": "@colearnia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "media:smoke": "tsx --env-file-if-exists=../../.env scripts/media-smoke.ts"
  },
  "dependencies": {
    "@colearnia/contracts": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mediasoup": "3.31.0",
    "mongoose": "9.11.4",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
