{
  "name": "colearnia",
  "version": "0.1.0",
  "private": true,
  "description": "Nền tảng học tập trực tuyến với không gian cộng tác và thảo luận nhóm thời gian thực",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": "11.5.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @colearnia/contracts build && concurrently -k -n contracts,server,web \"pnpm --filter @colearnia/contracts dev\" \"pnpm --filter @colearnia/server dev\" \"pnpm --filter @colearnia/web dev\"",
    "build": "pnpm -r --sort run build",
    "typecheck": "pnpm --filter @colearnia/contracts build && pnpm -r --sort run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @colearnia/contracts build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose up -d --wait mongo && docker compose run --rm mongo-init",
    "infra:down": "docker compose down",
    "infra:config": "docker compose config --quiet",
    "media:smoke": "pnpm --filter @colearnia/server media:smoke",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "node scripts/prepare.mjs",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
